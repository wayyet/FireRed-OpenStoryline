# === 本机 Claude Code 运行时元数据（不属项目源码）===
# 注：用户决定把 .claude/skills/ 整目录原样入仓，
# 但 .claude/ 顶层的 settings 文件和锁文件不属于 skill 本身。
# 此处忽略与 .claude/skills/ 无冲突；如需连 .claude/skills/ 也忽略，
# 把下面三行改成 `.claude/`。

# === bridge 模块运行数据 ===
bridge/input/
bridge/output/
bridge/logs/
bridge/tmp/
bridge/openstoryline/
bridge/route_a/
bridge/route_db/
bridge/assets/
bridge/cases/*/scratchpad/
bridge/cases/*/tmp/

# === 本机运行时产物（不入仓）===
# .worktrees/ 是 MiniMax Code 的 git fork 工作树残留（嵌套 git 仓库 + ownership json）
.worktrees/
# inputs/ 是用户素材目录（视频/图片源文件），不入仓
inputs/